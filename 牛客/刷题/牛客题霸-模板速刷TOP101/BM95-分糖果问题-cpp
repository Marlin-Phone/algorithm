/** @nc code=start */

class Solution {
public:
    /**
     * 代码中的类名、方法名、参数名已经指定，请勿修改，直接返回方法规定的值即可
     *
     * pick candy
     * @param arr int整型vector the array
     * @return int整型
     */
    int candy(vector<int>& arr) {
        int n = arr.size();
        if (n == 0) return 0;
        
        // 初始化每个孩子至少1个糖果
        vector<int> candies(n, 1);
        
        // 从左到右扫描：确保右边比左边高分的孩子获得更多糖果
        for (int i = 1; i < n; i++) {
            if (arr[i] > arr[i - 1]) {
                candies[i] = candies[i - 1] + 1;
            }
        }
        
        // 从右到左扫描：确保左边比右边高分的孩子获得更多糖果
        for (int i = n - 2; i >= 0; i--) {
            if (arr[i] > arr[i + 1]) {
                candies[i] = max(candies[i], candies[i + 1] + 1);
            }
        }
        
        // 计算总糖果数
        int total = 0;
        for (int candy : candies) {
            total += candy;
        }
        
        return total;
        
    }
};

