class Solution {
public:
    /**
     * 代码中的类名、方法名、参数名已经指定，请勿修改，直接返回方法规定的值即可
     *
     * max water
     * @param arr int整型vector the array
     * @return long长整型
     */
    long long maxWater(vector<int>& arr) {
        vector<int> left(arr.size(), 0);
        vector<int> right(arr.size(), 0);
        int height = 0;
        for(int i = 1; i < arr.size(); i++){
            height = arr[i - 1];
            cout << height << " " << endl;
            left[i] = max(left[i - 1], height);
        }
        for(int i = 0; i < arr.size(); i++){
            cout << left[i] << " ";
        }
        cout << endl;
        height = 0;
        for(int i = arr.size() - 2; i >= 0; i--){
            height = arr[i + 1];
            cout << height << " " << endl;
            right[i] = max(right[i + 1], height);
        }
        
        for(int i = 0; i < arr.size(); i++){
            cout << right[i] << " ";
        }
        cout << endl;
        int ans = 0;
        for(int i = 1; i < arr.size(); i++){
            ans += max(min(left[i], right[i]) - arr[i], 0);
        }
        return ans;
    }
};

