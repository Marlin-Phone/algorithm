#include <iostream>
using namespace std;

int main() {
    string s, t;
    cin >> s;
    cin >> t;
    int min_num = 1e9;
    for(int i = 0; i + s.size() <= t.size(); i++){
        int sum = 0;
        for(int j = 0; j < s.size(); j++){
            char c1 = t[i + j];
            char c2 = s[j];
            if(c1 == c2){
                continue;
            }else{
                int temp_min = min((c1 - c2 + 26) % 26, (c2 - c1 + 26) % 26);
                // cout << "temp_min = " << temp_min << endl;
                sum += temp_min;
            }
        }
        // cout << "sum = " << sum << endl;
        min_num = min(min_num, sum);
    }
    cout << min_num << endl;
    return 0;
}
