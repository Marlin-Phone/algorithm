#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    string s;
    cin >> s;
    int l = 0;
    int max_len = 0;
    for(int r = 0; r < n; r++){
        char c = s[r];

        if(c != 'a' && c != 'h'){
            l = r + 1;
            continue;
        }

        if(r > 0 && s[r] == s[r - 1]){
            l = r;
        }

        max_len = max(max_len, r - l + 1);
    }

    cout << max_len << endl;
    return 0;
}
