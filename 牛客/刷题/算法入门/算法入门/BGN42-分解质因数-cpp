#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main() {
    int n;
    cin >> n;
    vector<int> res;
    for(int i = 2; i * i <= n; i++){
        while(n % i == 0){
            n /= i;
            res.push_back(i);
        }
    }
    if(n){
        res.push_back(n);
    }
    for(auto it : res){
        cout << it << " ";
    }
}
