#include <iostream>
using namespace std;
#define int long long

signed main() {
    int n;
    cin >> n;
    if(n <= 1){
        cout << "No" << endl;
        return 0;
    }
    for(int i = 2; i * i <= n; i++){
        if(n % i == 0){
            cout << "No" << endl;
            return 0;
        }
    }
    cout << "Yes" << endl;
    return 0;

}
