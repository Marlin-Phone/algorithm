#include <bits/stdc++.h>
using namespace std;

vector<int> fa, sz;
void init(int n){
    fa.resize(n + 1);
    sz.resize(n + 1);
    for(int i = 0; i <= n; i++){
        fa[i] = i;
        sz[i] = 1;
    }
}
int find(int x){
    return x == fa[x] ? x : fa[x] = find(fa[x]);
}
bool merge(int x, int y){
    int fx = find(x), fy = find(y);
    if(fx == fy){
        return false;
    }
    fa[fx] = fy;
    sz[fy] += sz[fx];
    return true;
}
int size(int x){
    return sz[find(x)];
}


int main() {
    int n, m;
    cin >> n >> m;
    init(n);
    for(int i = 1; i <= m; i++){
        int op;
        cin >> op;
        if(op == 1){
            int x, y;
            cin >> x >> y;
            merge(x, y);
        }else if(op == 2){
            int x, y;
            cin >> x >> y;
            cout << (find(x) == find(y) ? "YES" : "NO") << endl;
        }else{
            int x;
            cin >> x;
            cout << size(x) << endl;
        }
    }
}
